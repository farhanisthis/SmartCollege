# Production environment variables for Netlify deployment
# 
# Set VITE_API_URL to your Render backend URL
# This tells the frontend where to send API requests
# 
# IMPORTANT: Update this with your actual Render backend URL
# You can find it in your Render dashboard
# It should look like: https://your-app-name.onrender.com

VITE_API_URL=https://smartcollege-server.onrender.com
