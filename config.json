{
  "app": {
    "name": "SmartCollege",
    "version": "1.0.0",
    "description": "A smart college management system for class updates and file sharing"
  },
  "database": {
    "type": "mongodb",
    "connectionTimeout": 10000,
    "maxPoolSize": 10,
    "minPoolSize": 1
  },
  "server": {
    "port": 10000,
    "host": "0.0.0.0",
    "cors": {
      "origin": "http://localhost:5173"
    }
  },
  "upload": {
    "maxFileSize": "50MB",
    "allowedTypes": [
      "application/pdf",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.ms-powerpoint",
      "application/vnd.openxmlformats-officedocument.presentationml.presentation",
      "image/jpeg",
      "image/png",
      "image/gif",
      "image/webp",
      "text/plain"
    ],
    "directory": "uploads",
    "maxFiles": 10
  },
  "session": {
    "secret": "supersecretkey",
    "maxAge": 86400000,
    "httpOnly": true,
    "secure": false
  },
  "categories": [
    {
      "id": "all",
      "name": "All Updates",
      "icon": "LayoutGrid",
      "color": "bg-primary text-primary-foreground"
    },
    {
      "id": "assignments",
      "name": "Assignments",
      "icon": "ClipboardList",
      "color": "bg-chart-1/20 text-chart-1"
    },
    {
      "id": "notes",
      "name": "Notes",
      "icon": "StickyNote",
      "color": "bg-chart-2/20 text-chart-2"
    },
    {
      "id": "presentations",
      "name": "Presentations",
      "icon": "Presentation",
      "color": "bg-chart-3/20 text-chart-3"
    },
    {
      "id": "general",
      "name": "General Updates",
      "icon": "Megaphone",
      "color": "bg-chart-5/20 text-chart-5"
    }
  ],
  "users": {
    "defaultClass": "Computer Science - Semester 5",
    "roles": ["student", "cr"],
    "passwordMinLength": 6
  },
  "features": {
    "filePreview": true,
    "fileDownload": true,
    "realTimeUpdates": true,
    "bookmarks": true,
    "sharing": true,
    "deadlineTracking": true
  },
  "theme": {
    "default": "dark",
    "options": ["light", "dark"]
  }
}
